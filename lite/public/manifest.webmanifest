{
  "name": "Songbook Lite",
  "short_name": "Songbook",
  "description": "Mixing desk show files in your browser: document, convert, Companion pages. Files never leave your machine.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "orientation": "any",
  "icons": [
